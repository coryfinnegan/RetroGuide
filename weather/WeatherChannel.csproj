<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the tray app must not flash a console window when it
         starts with Windows. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WeatherChannel</AssemblyName>
    <RootNamespace>WeatherChannel</RootNamespace>
    <ApplicationIcon />
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded, not copied: the app publishes as a single file, and the pages
         are rendered from a temp directory where a relative font path would not
         resolve. PageBuilder inlines these as data URIs. -->
    <EmbeddedResource Include="fonts\*.woff" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

</Project>
