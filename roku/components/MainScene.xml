<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <!-- Order here is z-order. The guide is drawn first so the video can
             sit on top of it as the corner window; the banner comes after the
             video so it is legible over a full screen picture.

             The guide is laid out after the two cable guides the design was
             taken from (photos the owner supplied): an info panel and the
             picture across the top, a dense grid below with one highlighted
             cell, and a key-hint bar. Every surface is a flat, embossed plate,
             as on the Prevue Channel grid of 1993-99 - see THEMES.md. Plates
             are built in code; this file only places the text. -->
        <Group id="guide" visible="false">
            <Rectangle id="guideBg" width="1920" height="1080" color="0x0C0C3AFF" />

            <!-- Info panel, top left. -->
            <Group id="panelPlate" />
            <Poster id="logoArt" translation="[72,52]" width="72" height="72" />
            <Label id="logoA" translation="[156,58]" />
            <Label id="logoB" translation="[156,58]" />
            <Label id="clock" translation="[800,58]" width="404" horizAlign="right" />
            <Rectangle id="panelRule" translation="[72,136]" width="1132" height="4" />
            <Label id="infoTitle" translation="[72,154]" width="1132" />
            <Label id="infoTime" translation="[72,226]" width="1132" />
            <Label id="infoChannel" translation="[72,272]" width="1132" />
            <Label id="infoNext" translation="[72,322]" width="1132" />

            <!-- Border round the picture window, top right. -->
            <Rectangle id="windowFrame" translation="[1252,40]" width="620" height="349" />

            <!-- Time bar, rows and hint bar: rebuilt by paintGrid(). -->
            <Group id="grid" />
            <Group id="footer" />

            <!-- Theme art, over the edges of the panel and the hint bar. -->
            <Group id="deco" />
        </Group>

        <!-- Sized full screen while watching, shrunk into the guide's
             picture window when the guide opens. -->
        <Video id="video" width="1920" height="1080" translation="[0,0]" />

        <!-- Channel banner: number, name, and what is on now. -->
        <Group id="banner" visible="false" translation="[80,820]">
            <Group id="bannerPlate" />
            <Label id="bannerNumber" translation="[30,46]" width="200" horizAlign="center" />
            <Label id="bannerName" translation="[250,36]" width="1200" />
            <Label id="bannerNow" translation="[250,104]" width="1200" />
        </Group>

        <!-- First run / server moved. -->
        <Group id="setup" visible="false">
            <Rectangle width="1920" height="1080" color="0x0A0A32FF" />
            <Label translation="[120,110]" text="RETRO GUIDE" color="0xFFC020FF"
                   font="font:LargeBoldSystemFont" />
            <Label id="setupStatus" wrap="true" translation="[120,190]" width="1680" numLines="2"
                   color="0xF2F2FFFF" font="font:MediumSystemFont" />
            <Group id="setupList" translation="[120,300]" />
            <Label translation="[120,960]" width="1680" wrap="true" numLines="2" color="0x66E0FFFF"
                   font="font:SmallSystemFont"
                   text="Up/Down to choose, OK to select. The address is remembered, so this is a one time step." />
        </Group>

        <!-- Settings: the options (*) button. -->
        <Group id="settings" visible="false">
            <Rectangle id="settingsBg" width="1920" height="1080" color="0x0A0A32FF" />
            <Label id="settingsTitle" translation="[120,150]" width="1680" horizAlign="center"
                   text="SETTINGS" />
            <Group id="settingsList" translation="[320,280]" />
            <Label id="settingsHint" translation="[120,880]" width="1680" horizAlign="center"
                   text="UP/DOWN CHOOSE    LEFT/RIGHT CHANGE    OK SELECT    BACK CLOSE" />
        </Group>

        <Label id="status" wrap="true" translation="[120,500]" width="1680" numLines="3"
               horizAlign="center" color="0xF2F2FFFF" font="font:LargeBoldSystemFont" />
    </children>
</component>
