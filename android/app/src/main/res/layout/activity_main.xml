<?xml version="1.0" encoding="utf-8"?>
<!--
  The nineties TV Guide channel layout: a video window pinned top-left, the
  current programme beside it, and the scrolling grid filling the bottom.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/guide_bg">

    <!-- Fullscreen playback. The guide sits on top of it. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/fullPlayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:use_controller="false"
        app:resize_mode="fit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ CHANNEL BANNER (shown briefly on channel change) ============ -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/banner_bg"
        android:padding="16dp"
        android:layout_margin="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/bannerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/guide_amber"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:minWidth="90dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="18dp">

            <TextView
                android:id="@+id/bannerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/guide_white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/bannerNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/guide_cyan"
                android:textSize="18sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ GUIDE OVERLAY ============ -->
    <FrameLayout
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/guide_bg"
        android:visibility="gone">

        <!--
          Laid out after the two cable guides this was modelled on: an info
          panel and the picture across the top, the grid below, and a key-hint
          bar along the bottom.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- the picture, top right -->
            <FrameLayout
                android:id="@+id/windowFrame"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="3dp"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintWidth_percent="0.34"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/windowPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:resize_mode="zoom" />
            </FrameLayout>

            <!-- info panel: logo and clock, then the highlighted programme -->
            <LinearLayout
                android:id="@+id/infoPanel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toTopOf="@id/windowFrame"
                app:layout_constraintBottom_toBottomOf="@id/windowFrame"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/windowFrame">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/logoArt"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/logoA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/logoB"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp" />
                </LinearLayout>

                <View
                    android:id="@+id/panelRule"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/infoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="25sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/infoTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="17sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/infoChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/infoNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <com.ersatz.retroguide.GuideGridView
                android:id="@+id/guideGrid"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                app:layout_constraintTop_toBottomOf="@id/windowFrame"
                app:layout_constraintBottom_toTopOf="@id/guideFooter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/guideFooter"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Theme art, over the edges of the panel and the hint bar. -->
        <FrameLayout
            android:id="@+id/decoLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/guide_amber"
        android:textSize="24sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Settings. Back never exits this app, so an explicit way out belongs
         here: the quickest fix for a wedged stream is starting over. -->
    <LinearLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/guide_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="@color/guide_amber"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="26dp" />

        <TextView android:id="@+id/settingTheme"   style="@style/SettingRow" />
        <TextView android:id="@+id/settingServer"  style="@style/SettingRow" />
        <TextView android:id="@+id/settingRestart" style="@style/SettingRow" />
        <TextView android:id="@+id/settingClose"   style="@style/SettingRow" />
        <TextView android:id="@+id/settingBack"    style="@style/SettingRow" />

        <TextView
            android:id="@+id/settingsHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="UP/DOWN CHOOSE   LEFT/RIGHT CHANGE   OK SELECT   BACK CANCEL"
            android:textColor="@color/guide_cyan"
            android:textSize="15sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
